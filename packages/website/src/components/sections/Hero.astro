---
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import heroImage from '@/assets/hero-landing.png';
---

<section class="relative min-h-[100svh] flex items-center overflow-hidden texture-overlay">
  <!-- Background hero image -->
  <Image
    src={heroImage}
    alt="Biblical figures walking along an ancient sunlit pathway toward a distant city"
    class="absolute inset-0 w-full h-full object-cover"
    widths={[768, 1280, 1536]}
    sizes="100vw"
    loading="eager"
    quality={85}
  />
  <!-- Layered warm overlays for depth + readability -->
  <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-ink)] via-[var(--color-ink)]/72 to-transparent" />
  <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-ink)] via-transparent to-[var(--color-ink)]/40" />
  <!-- Divine light, drifting slowly from above -->
  <div class="hero-light absolute -top-40 left-1/3 w-[55rem] h-[55rem] rounded-full pointer-events-none" />
  <!-- Cinematic vignette -->
  <div class="absolute inset-0 pointer-events-none" style="box-shadow: inset 0 0 220px 60px rgba(13,10,6,0.85);" />
  <!-- Subtle golden glow from lower-left -->
  <div class="absolute -bottom-32 -left-20 w-[40rem] h-[40rem] bg-[var(--color-ochre)]/15 rounded-full blur-3xl pointer-events-none" />

  <div class="container mx-auto px-6 lg:px-8 relative z-10 pt-28 pb-24">
    <div class="max-w-4xl lg:max-w-3xl">
      <!-- Eyebrow -->
      <p class="eyebrow eyebrow--light mb-7 animate-fade-in">
        Wisdom From The Ages
      </p>

      <!-- Main headline -->
      <h1 class="text-5xl md:text-6xl lg:text-7xl text-white leading-[0.98] mb-7 animate-fade-in" style="animation-delay: 0.1s">
        Converse with the<br/>
        <span class="italic text-gradient-gold">Voices of Scripture</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-xl md:text-2xl text-white/85 max-w-xl mb-8 leading-relaxed animate-fade-in" style="animation-delay: 0.2s">
        Sit with Jesus, Moses, David, and eleven more. Ask the questions your heart carries — and receive wisdom drawn straight from the Word.
      </p>

      <!-- Scripture line -->
      <p class="text-[var(--color-ochre-light)]/90 italic text-lg max-w-md mb-10 pl-5 border-l-2 border-[var(--color-ochre)]/50 animate-fade-in" style="animation-delay: 0.25s">
        &ldquo;Your word is a lamp to my feet and a light to my path.&rdquo;
        <span class="block not-italic text-sm tracking-widest uppercase text-white/45 mt-2">Psalm 119:105</span>
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center animate-fade-in" style="animation-delay: 0.3s">
        <a
          href="https://app.christianai.world/signup"
          target="_blank"
          rel="noopener noreferrer"
          onclick="if(window.gtag){gtag('event', 'sign_up', {source: 'hero'});}"
          class="btn-sacred inline-flex items-center justify-center gap-3"
        >
          Begin Your Journey
          <ArrowRight class="w-5 h-5" />
        </a>
        <a
          href="#figures"
          class="btn-ghost btn-ghost--light inline-flex items-center justify-center"
        >
          Meet the Figures
        </a>
      </div>

      <!-- Trust signals -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-10 text-white/55 text-sm animate-fade-in" style="animation-delay: 0.35s">
        <span class="inline-flex items-center gap-2"><span class="text-[var(--color-ochre)]">&#10041;</span> 14 Biblical Figures</span>
        <span class="inline-flex items-center gap-2"><span class="text-[var(--color-ochre)]">&#10041;</span> Always Free</span>
        <span class="inline-flex items-center gap-2"><span class="text-[var(--color-ochre)]">&#10041;</span> Private &amp; Secure</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-white/40 hidden sm:flex">
    <span class="text-xs tracking-[0.3em] uppercase">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-[var(--color-ochre)]/70 to-transparent scroll-line" />
  </div>
</section>

<style>
  .hero-light {
    background: radial-gradient(circle, rgba(231, 205, 134, 0.28) 0%, rgba(231, 205, 134, 0.08) 35%, transparent 68%);
    filter: blur(40px);
    animation: heroDrift 16s ease-in-out infinite;
  }

  @keyframes heroDrift {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.9; }
    50% { transform: translate(-3%, 4%) scale(1.08); opacity: 1; }
  }

  .scroll-line {
    transform-origin: top;
    animation: scrollPulse 2.4s var(--ease-sacred) infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-light, .scroll-line { animation: none; }
  }
</style>
