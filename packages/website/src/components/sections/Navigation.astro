---
// Navigation — sacred dark bar, transparent at top, solidifies on scroll
---

<!-- SVG Icon Definitions -->
<svg class="hidden">
  <defs>
    <symbol id="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
    </symbol>
    <symbol id="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </symbol>
    <symbol id="external-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
    </symbol>
  </defs>
</svg>

<header
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 border-b border-transparent"
  id="navbar"
>
  <nav class="container mx-auto px-5 lg:px-8">
    <div class="flex items-center justify-between h-[72px]">
      <!-- Logo -->
      <a href="/" class="flex items-center group" aria-label="ChristianAI home">
        <img
          src="/images/logo.svg"
          alt="ChristianAI Logo - AI-Powered Biblical Conversations"
          class="h-11 w-auto invert transition-transform duration-300 group-hover:scale-105"
          id="nav-logo"
          loading="eager"
        />
      </a>

      <!-- Navigation Links -->
      <div class="hidden md:flex items-center gap-8">
        <a
          href="/features"
          class="nav-link text-sm tracking-wide text-white/80 hover:text-[var(--color-ochre-light)] transition-colors duration-200 relative group py-1"
        >
          Features
          <span class="absolute -bottom-0.5 left-0 w-0 h-px bg-[var(--color-ochre)] group-hover:w-full transition-all duration-300 ease-out"></span>
        </a>
        <a
          href="/blog/"
          class="nav-link text-sm tracking-wide text-white/80 hover:text-[var(--color-ochre-light)] transition-colors duration-200 relative group py-1"
        >
          Blog
          <span class="absolute -bottom-0.5 left-0 w-0 h-px bg-[var(--color-ochre)] group-hover:w-full transition-all duration-300 ease-out"></span>
        </a>
        <a
          href="https://app.christianai.world"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-sacred inline-flex items-center gap-2 !text-sm !py-2.5 !px-6"
        >
          Launch App
          <svg class="w-4 h-4">
            <use href="#external-link-icon"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-white hover:text-[var(--color-ochre-light)] transition-colors duration-200"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="menu-icon-svg">
          <use href="#menu-icon"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden pb-5 overflow-hidden"
    >
      <div class="flex flex-col gap-2 animate-fadeIn border-t border-[var(--color-ochre)]/20 pt-4">
        <a
          href="/features"
          class="text-white/85 hover:text-[var(--color-ochre-light)] font-medium transition-colors duration-200 py-2.5 px-2 rounded"
        >
          Features
        </a>
        <a
          href="/blog/"
          class="text-white/85 hover:text-[var(--color-ochre-light)] font-medium transition-colors duration-200 py-2.5 px-2 rounded"
        >
          Blog
        </a>
        <a
          href="https://app.christianai.world"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-sacred inline-flex items-center gap-2 !text-sm !py-2.5 !px-6 self-start mt-2"
        >
          Launch App
          <svg class="w-4 h-4">
            <use href="#external-link-icon"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</header>

<!-- Spacer so fixed nav never overlaps page content lacking its own hero offset -->

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconSvg = document.getElementById('menu-icon-svg');

  if (mobileMenuButton && mobileMenu && menuIconSvg) {
    let isOpen = false;

    mobileMenuButton.addEventListener('click', () => {
      isOpen = !isOpen;
      mobileMenu.classList.toggle('hidden');
      mobileMenuButton.setAttribute('aria-expanded', String(isOpen));

      menuIconSvg.innerHTML = isOpen ? '<use href="#close-icon"/>' : '<use href="#menu-icon"/>';
      menuIconSvg.classList.toggle('rotate-90', isOpen);
    });
  }

  // Scroll-based background: transparent at top, sacred glass on scroll
  const navbar = document.getElementById('navbar');

  if (navbar) {
    const onScroll = () => {
      if (window.scrollY > 40) {
        navbar.classList.add('nav-scrolled');
      } else {
        navbar.classList.remove('nav-scrolled');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  /* Always-on sacred glass — legible over light and dark heroes alike */
  #navbar {
    background: rgba(20, 17, 13, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* Deepen once scrolled */
  #navbar.nav-scrolled {
    background: rgba(20, 17, 13, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgba(196, 163, 90, 0.18);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out;
  }
</style>
